<style>
 
  .offcanvas{
    width:230px;
    opacity: 0.8;
}

.offcanvas-title{
    color:#14B8A6;
    font-weight:bold;
}

.offcanvas .nav-link{
    font-size:1.1rem;
    padding:12px 0;
    color:#333;
    transition:0.3s;
}

.offcanvas .nav-link:hover{
    color:#fe424d;
    padding-left:10px;
}

@media (max-width:767px){

    .btn-search,
    .input-search,
    .btn-user{
        display:none !important;
    }
}

@media (min-width:768px){
    .offcanvas{
        display:none;
    }
}

@media (min-width:768px){
    .navbar-toggler{
        display:none;
    }
}

.btn-search{
     margin-right: 17rem;
}

.input-search{
   height: 3rem;
   width: 12rem;
   border-radius: 15px;
}

.nav-link{
  padding: 1rem;
  margin: 0.5rem;
  transition: all 0.1s;
}

.nav-link:hover{
  border: 1px solid black;
}


  
</style>
    
   
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
    <div class="container-fluid">

        <a class="navbar-brand" href="/listings">
            <img src="/logo.avif" alt="Logo" width="60" height="60">
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#mobileMenu"
                aria-controls="mobileMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

            <div class="navbar-nav d-none d-md-flex">
                <a class="nav-link" href="/listings">Home</a>
                <a class="nav-link explore" href="/listings/explore">Explore</a>
            </div>

            <div class="navbar-nav ms-auto d-none d-md-flex align-items-center">

                <form class="d-flex me-3 btn-search" role="search">
                    <input class="form-control me-2 input-search"
                           type="search"
                           placeholder="Where to escape?">

                    <button class="btn btn-search" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i> Search
                    </button>
                </form>

                <a class="nav-link" href="/listings/new">
                    TripNest your home
                </a>

                <% if(typeof currUser === "undefined" || !currUser){ %>

                    <a class="nav-link" href="/signup">
                        <b>Sign Up</b>
                    </a>

                    <a class="nav-link" href="/login">
                        <b>Login</b>
                    </a>

                <% } else { %>

                    <a class="nav-link" href="/logout">
                        <b>Logout</b>
                    </a>

                <% } %>

            </div>

        </div>

    </div>
</nav>


<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu">

    <div class="offcanvas-header">
        <h4 class="offcanvas-title" style="font: cursive">TripNest</h4>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas">
        </button>
    </div>

    <div class="offcanvas-body">

        <a class="nav-link mb-3" href="/listings">
            Home
        </a>

        <a class="nav-link mb-3" href="/listings/explore">
            Explore
        </a>

        <a class="nav-link mb-3" href="/listings/new">
            TripNest your home
        </a>

        <% if(!currUser){ %>

            <a class="nav-link mb-3" href="/signup">
                Sign Up
            </a>

            <a class="nav-link mb-3" href="/login">
                Login
            </a>

        <% } else { %>

            <a class="nav-link text-danger" href="/logout">
                Logout
            </a>

        <% } %>

    </div>

</div>
