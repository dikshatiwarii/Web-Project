<% layout("/layouts/boilerplate") %>

<div class="row mt-3 h-100 signup offset-lg-3">
    <h1 class="">Sign-Up on TripNest</h1>
    <br><br>
    <div class="col-lg-6 col-sm-1">
        <form action="/signup" method="POST" novalidate class="needs-validation">
            
        <div class = "mb-3">
            <label for = "username" class = "form-label">Username</label>
            <input name="username" id="username" type = "text" class="form-control" required>
            <div class = "valid-feedback">Looks good!</div>
        </div>

         <div class = "mb-3">
            <label for = "email" class = "form-label">E-mail</label>
            <input name="email" id="username" type = "text" class="form-control" required>
        </div>

         <div class = "mb-3">
            <label for = "password" class = "form-label">Password</label>
            <input name="password" id="password" type = "password" class="form-control" required>
            <div class = "valid-feedback">Looks good!</div>
        </div>

        <button class="btn btn-success">SignUp</button>

        </form>
    </div>
</div>