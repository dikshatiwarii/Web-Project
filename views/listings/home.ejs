<!DOCTYPE html>
<html lang="en">
<head>
    <link rel ="icon" type="image/avif" href="/logo.avif">
    <title>TripNest</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            height:100vh;
            background-image: linear-gradient(rgba(0,0,0,0.45),
            rgba(0,0,0,0.45)),
            url("https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1800&q=80");
            background-size:cover;
            background-position:center;
            background-repeat:no-repeat;
            display:flex;
            justify-content:center;
            align-items:center;
            font-family:Arial, Helvetica, sans-serif;
        }

        .hero{
            text-align:center;
            color:white;
            background:rgba(255,255,255,0.12);
            backdrop-filter:blur(8px);
            padding:50px;
            border-radius:20px;
            width:700px;
        }

        .hero h1{
            font-size:4rem;
            font-weight:bold;
        }

        .hero p{
            font-size:1.3rem;
            margin:20px 0 35px;
        }

        .btn-custom{
            width:160px;
            margin:10px;
            padding:12px;
            font-size:18px;
            border-radius:30px;
        }

        .home-btn{
            background:#198754;
            color:white;
        }

        .login-btn{
            background:#0d6efd;
            color:white;
        }

        .signup-btn{
            background:#ffc107;
            color:black;
        }

        .btn-custom:hover{
            transform:translateY(-3px);
            transition:.3s;
        }

        .tripnest-title{
            font-family: 'Pacifico', cursive;
            font-size: 5rem;
            color: white;
            text-shadow: 3px 3px 8px rgba(0,0,0,0.4);
        }

        @media (max-width: 768px) {

    .hero{
        width: 90%;
        padding: 30px;
    }

    .tripnest-title{
        font-size: 3rem;
    }

    .hero p{
        font-size: 1rem;
    }

    .btn-custom{
        width: 100%;
        margin-bottom: 10px;
    }
}
    </style>
</head>

<body>

<div class="hero">

    <h1 class="tripnest-title">TripNest</h1>

    <p>
        Discover breathtaking destinations, luxurious stays,
        and unforgettable travel experiences.
    </p>

    <a href="/listings/explore" class="btn btn-custom home-btn">
        &#127759; Explore
    </a>

    <a href="/login" class="btn btn-custom login-btn">
        🔐 Login
    </a>

    <a href="/signup" class="btn btn-custom signup-btn">
        👤 Sign Up
    </a>

</div>

</body>
</html>